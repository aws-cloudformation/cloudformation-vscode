{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceRoot}/out/**/*.js",
        "${workspaceRoot}/out/**/*.js.map",
        "${workspaceRoot}/out/src/**/*.js",
        "${workspaceRoot}/out/src/**/*.js.map"
      ],
      "preLaunchTask": "${defaultBuildTask}",
      "env": {
        "NODE_ENV": "development",
        "AWS_ENV": "alpha"
      }
    }
  ]
}
